<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- The external programs the app needs. One row per program, built in ToolsView: a
     missing one carries its install instructions. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="uz.jtscorp.filesync.ui.ToolsView">
    <center>
        <ScrollPane fitToWidth="true" styleClass="page-scroll">
            <VBox spacing="16" styleClass="page, tools-page">
                <VBox spacing="2">
                    <Label text="%main.tools" styleClass="page-title"/>
                    <Label text="%tools.subtitle"
                           styleClass="muted"/>
                </VBox>
                <VBox fx:id="toolRows" styleClass="card, result-card"/>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="footer-bar">
            <Label fx:id="footerLabel" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="recheckButton" text="%tools.recheck" styleClass="btn" onAction="#onRecheck"/>
            <Button fx:id="continueButton" text="%tools.continue" styleClass="btn-primary" onAction="#onContinue"/>
        </HBox>
    </bottom>
</BorderPane>
