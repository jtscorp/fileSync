<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Step 1. Layout only; the chips, the quick-add presets and the footer text are built
     in SetupView because they depend on what the form currently holds. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="uz.jtscorp.filesync.ui.SetupView">
    <center>
        <ScrollPane fitToWidth="true" styleClass="page-scroll">
            <VBox spacing="16" styleClass="page">
                <VBox spacing="2">
                    <Label text="%step.setup" styleClass="page-title"/>
                    <Label text="%setup.subtitle" styleClass="muted"/>
                </VBox>

                <VBox spacing="12" styleClass="card">
                    <Label text="%setup.folders" styleClass="card-title"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="64" prefWidth="64"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints/>
                        </columnConstraints>
                        <HBox spacing="6" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Region styleClass="dot, side-dot, dot-lap"/>
                            <Label text="%side.laptop" styleClass="lap-text, w500"/>
                        </HBox>
                        <TextField fx:id="laptopPathField" promptText="%setup.laptopPrompt" styleClass="field, lap"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Button text="%setup.browse" styleClass="btn" onAction="#onBrowseLaptop"
                                GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="syncHintLabel" styleClass="faint, small"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <HBox spacing="6" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <Region styleClass="dot, side-dot, dot-hdd"/>
                            <Label text="%side.hdd" styleClass="hdd-text, w500"/>
                        </HBox>
                        <TextField fx:id="hddPathField" promptText="%setup.hddPrompt" styleClass="field, hdd"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Button text="%setup.browse" styleClass="btn" onAction="#onBrowseHdd"
                                GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    </GridPane>
                </VBox>

                <VBox spacing="12" styleClass="card">
                    <HBox spacing="10" alignment="BASELINE_LEFT">
                        <Label text="%setup.ignored" styleClass="card-title"/>
                        <Label text="%setup.ignoreHint"
                               styleClass="faint, small"/>
                    </HBox>
                    <FlowPane fx:id="chipsPane" hgap="6" vgap="6"/>
                    <HBox spacing="8">
                        <TextField fx:id="newIgnorePatternField" promptText="*.tmp, Private/secret-notes … (Enter)"
                                   styleClass="field" onAction="#onAddIgnorePattern" HBox.hgrow="ALWAYS"/>
                        <Button text="%setup.add" styleClass="btn" onAction="#onAddIgnorePattern"/>
                        <Button text="%setup.fromFolder" styleClass="btn" onAction="#onBrowseIgnoreFolder"/>
                    </HBox>
                    <FlowPane fx:id="suggestionsPane" hgap="6" vgap="6" alignment="CENTER_LEFT"/>
                </VBox>

                <HBox fx:id="mergeCard" spacing="14" styleClass="card, clickable-card" onMouseClicked="#onToggleMerge">
                    <StackPane fx:id="mergeSwitch" styleClass="switch">
                        <Region styleClass="switch-knob"/>
                    </StackPane>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="%setup.merge.title" styleClass="card-title"/>
                        <Label wrapText="true" styleClass="muted"
                               text="%setup.merge.body"/>
                        <Label wrapText="true" styleClass="faint, small"
                               text="%setup.merge.caveat"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="footer-bar">
            <Label fx:id="statusLabel" styleClass="muted"/>
            <Button fx:id="detailsButton" text="%setup.details" styleClass="btn-ghost" onAction="#onShowDetails"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%setup.save" styleClass="btn" onAction="#onSave"/>
            <Button fx:id="checkButton" text="%setup.saveAndCheck" styleClass="btn-primary"
                    onAction="#onSaveAndCheck"/>
        </HBox>
    </bottom>
</BorderPane>
